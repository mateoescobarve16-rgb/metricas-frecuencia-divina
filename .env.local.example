# Project URL del proyecto de Supabase "metricas-frecuencia-divina" (Settings > API)
SUPABASE_URL=

# Secret key del proyecto (Settings > API > API Keys > "Secret key", empieza con sb_secret_).
# NUNCA exponer con el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Credenciales de la API de Hotmart (Herramientas > Credenciales en tu cuenta de Hotmart).
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
HOTMART_BASIC_TOKEN=
